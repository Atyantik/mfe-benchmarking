{
  "name": "module-federation-evaluation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/stack.mjs start",
    "stack": "node scripts/stack.mjs",
    "build": "pnpm -r --filter \"./stacks/**\" run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "budget": "node packages/bench/src/budget.mjs",
    "verify": "pnpm --filter @mf-eval/bench run all",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm budget",
    "clean": "rm -rf stacks/*/*/dist packages/*/dist",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "eslint": "catalog:",
    "@mf-eval/eslint-config": "workspace:*",
    "vitest": "catalog:",
    "@mf-eval/vitest-config": "workspace:*",
    "lint-staged": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "eslint --max-warnings 0"
    ],
    "*.json": []
  }
}
