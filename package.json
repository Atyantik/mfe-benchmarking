{
  "name": "module-federation-evaluation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "bench": "pnpm --filter @mf-eval/bench run bench",
    "clean": "rm -rf stacks/*/*/dist stacks/*/*/dist-ssr packages/*/dist",
    "stack": "node scripts/stack.mjs",
    "verify": "pnpm --filter @mf-eval/bench run all",
    "test": "pnpm -r --filter \"./packages/**\" run test"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:"
  }
}
